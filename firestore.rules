rules_version = '2';
// Wiwe Apartments: Firestore security rules (v3.6: admin changes need two admins; v3.7.2: bellSeen).
// Published automatically by .github/workflows/deploy-rules.yml when this file changes.
// By hand: paste into Firebase console > Firestore Database > Rules, then Publish.
// The app hides buttons by role, but THESE rules are what actually stop a staff member
// from changing a rate, shrinking a bill or passing their own inspection, even through
// the browser console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(userPath()).data; }
    function active() { return signedIn() && exists(userPath()) && me().active == true; }
    function anyRole(list) { return active() && me().roles.hasAny(list.concat(['admin'])); }
    function admin() { return active() && me().roles.hasAny(['admin']); }
    function desk() { return anyRole(['manager', 'frontdesk']); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function settings() { return get(/databases/$(database)/documents/settings/general).data; }
    function stampedByMe() { return request.resource.data.by == request.auth.uid; }

    // ---- Admin accounts (v3.6): no single admin can remove another, or make a new one ----
    function isAdminDoc(d) { return d.get('active', false) == true && d.get('roles', []).hasAny(['admin']); }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function adminsPath() { return /databases/$(database)/documents/meta/admins; }
    function soleAdmin() { return get(adminsPath()).data.uids == [request.auth.uid]; }
    function listedAfter(uid) { return getAfter(adminsPath()).data.uids.hasAny([uid]); }
    function reqPath(id) { return /databases/$(database)/documents/adminRequests/$(id); }
    // Ready: two admins (never the person it is about) approved it, or it was raised with a
    // 3-day wait (only two admins) and the wait is over without anyone blocking it.
    function reqReady(r) {
      return r.status == 'pending'
        && (r.approvals.size() >= 2 || (r.waitUntil > 0 && request.time.toMillis() >= r.waitUntil));
    }
    // The change being written is the one a ready request asked for, and the request is closed in the same write
    function reqUsed(id, uid, types) {
      return id is string && id != ''
        && reqReady(get(reqPath(id)).data)
        && get(reqPath(id)).data.target == uid
        && get(reqPath(id)).data.type in types
        && getAfter(reqPath(id)).data.status == 'done';
    }
    // An account whose password was just reset cannot approve admin changes for 2 hours,
    // unless another admin has confirmed the reset.
    function frozen() {
      return me().get('resetAt', 0) > request.time.toMillis() - 7200000 && me().get('resetConfirmed', false) != true;
    }
    function resetKeysTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['resetAt', 'resetBy', 'replaces', 'resetConfirmed', 'resetConfirmedBy', 'resetConfirmedAt']);
    }
    // The new login that takes over an admin account (password reset by one admin, or an approved handover)
    function takesOverAdmin(uid) {
      let n = request.resource.data;
      let old = n.get('replaces', '');
      return old is string && old != ''
        && isAdminDoc(get(userDoc(old)).data)
        && getAfter(userDoc(old)).data.get('handedOverTo', '') == uid
        && listedAfter(uid)
        && (getAfter(userDoc(old)).data.get('endedReason', '') == 'handover'
            || (n.get('resetBy', '') == request.auth.uid && n.get('resetAt', 0) > request.time.toMillis() - 600000));
    }
    // The old login of an admin account that is being removed, reset or handed over
    function leavesAdmin(uid) {
      let n = request.resource.data;
      let why = n.get('endedReason', '');
      return (why == 'password_reset' && getAfter(userDoc(n.get('handedOverTo', 'none'))).data.get('replaces', '') == uid)
        || (why == 'handover' && reqUsed(n.get('adminReq', ''), uid, ['handover']))
        || (why != 'handover' && why != 'password_reset' && reqUsed(n.get('adminReq', ''), uid, ['remove']));
    }
    function adminsChangeOk() {
      let o = resource.data.uids.toSet();
      let n = request.resource.data.uids.toSet();
      let add = request.resource.data.get('added', '');
      let rem = request.resource.data.get('removed', '');
      return n.difference(o) == (add == '' ? [].toSet() : [add].toSet())
        && o.difference(n) == (rem == '' ? [].toSet() : [rem].toSet())
        && (add == '' || isAdminDoc(getAfter(userDoc(add)).data))
        && (rem == '' || !isAdminDoc(getAfter(userDoc(rem)).data));
    }
    function unOwnerFree(u, name, deleting) {
      return u == request.auth.uid || !exists(userDoc(u)) || !isAdminDoc(get(userDoc(u)).data)
        || !isAdminDoc(getAfter(userDoc(u)).data)
        || (deleting && getAfter(userDoc(u)).data.get('username', '') != name);
    }

    // The nightly rate of the room a stay is in, as set by the owner
    function typeRate(roomId) {
      return get(/databases/$(database)/documents/roomTypes/$(get(/databases/$(database)/documents/rooms/$(roomId)).data.typeId)).data.rate;
    }
    // When a stay first gets a bill: the rate must be the owner's rate and the total cannot be
    // less than rate x nights minus the discount (which the owner approves separately).
    function firstBillOk(n) {
      return !('total' in n)
        || (n.rate == typeRate(n.roomId) && n.total >= n.rate * n.nights - n.get('discount', 0));
    }
    // Afterwards: the rate is fixed, and the bill can only keep pace with the nights or go up.
    function billNotShrunk(o, n) {
      return n.rate == o.rate && (n.total - n.nights * n.rate >= o.total - o.nights * o.rate);
    }
    function discountOk() {
      return request.resource.data.get('discountStatus', 'none') in ['none', 'pending'];
    }

    // First-time setup: the very first account becomes admin, once.
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/meta/setup)
        && getAfter(userPath()).data.roles.hasAny(['admin']);
      allow update, delete: if false;
    }
    // The app reads this (empty) spot to tell whether these v3 rules are the ones published.
    match /meta/rules {
      allow read: if signedIn();
      allow write: if false;
    }

    // Who the admins are. It changes only together with that admin's own account (see the users rules).
    match /meta/admins {
      allow read: if active();
      allow create: if !exists(adminsPath()) && request.resource.data.uids.hasAny([request.auth.uid])
        && (admin() || (signedIn() && !exists(/databases/$(database)/documents/meta/setup)
                        && existsAfter(/databases/$(database)/documents/meta/setup)));
      allow update: if admin() && adminsChangeOk();
      allow delete: if false;
    }

    // Admin changes that need two admins: making someone admin, removing an admin (deactivating
    // or taking the role away) and handing an admin account to a new person.
    match /adminRequests/{id} {
      allow read: if admin();
      allow create: if admin() && stampedByMe() && !frozen()
        && request.resource.data.status == 'pending'
        && request.resource.data.approvals == [request.auth.uid]
        && request.resource.data.target != request.auth.uid
        && request.resource.data.type in ['grant', 'remove', 'handover']
        && (request.resource.data.waitUntil == 0
            || request.resource.data.waitUntil >= request.time.toMillis() + 259200000 - 600000);
      allow update: if admin() && resource.data.status == 'pending' && (
          (onlyChanges(['approvals', 'approvedAt']) && !frozen()
            && request.auth.uid != resource.data.target
            && !resource.data.approvals.hasAny([request.auth.uid])
            && request.resource.data.approvals == resource.data.approvals.concat([request.auth.uid]))
          || (onlyChanges(['status', 'closedBy', 'closedAt']) && request.resource.data.closedBy == request.auth.uid
              && ((request.resource.data.status == 'blocked' && request.auth.uid != resource.data.by)
                  || (request.resource.data.status == 'cancelled' && request.auth.uid == resource.data.by)
                  || (request.resource.data.status == 'done' && reqReady(resource.data))))
        );
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if active() || (signedIn() && request.auth.uid == uid);
      allow create: if (admin() && (!isAdminDoc(request.resource.data)
                                    || (soleAdmin() && listedAfter(uid))
                                    || takesOverAdmin(uid)))
        || (signedIn() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/meta/setup)
            && existsAfter(/databases/$(database)/documents/meta/setup));
      allow update: if (signedIn() && request.auth.uid == uid && onlyChanges(['onboarded', 'onboardedAt', 'inviteCode', 'photo', 'photoAt', 'bellSeen'])
                        && request.resource.data.get('bellSeen', {}) is map && request.resource.data.get('bellSeen', {}).size() <= 300)
        || (admin() && !resetKeysTouched() && (
              isAdminDoc(resource.data) == isAdminDoc(request.resource.data)
              || (isAdminDoc(request.resource.data) && listedAfter(uid)
                  && (soleAdmin() || reqUsed(request.resource.data.get('adminReq', ''), uid, ['grant'])))
              || (!isAdminDoc(request.resource.data) && !listedAfter(uid) && leavesAdmin(uid))))
        // another admin (not the one who did the reset, not the account itself) confirms a password reset
        || (admin() && !frozen() && uid != request.auth.uid
            && onlyChanges(['resetConfirmed', 'resetConfirmedBy', 'resetConfirmedAt'])
            && request.resource.data.resetConfirmed == true && request.resource.data.resetConfirmedBy == request.auth.uid
            && resource.data.get('resetBy', '') != request.auth.uid);
      allow delete: if false;
    }

    // One-time onboarding links. Readable only by someone who has the (random) code, until it expires.
    match /invites/{code} {
      allow get: if admin() || resource.data.expires > request.time.toMillis();
      allow list: if false;
      allow create, update: if admin();
      allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Username -> hidden login. One name can be looked up before sign-in (the login screen needs it),
    // but the whole list cannot be read.
    match /usernames/{name} {
      allow get: if true;
      allow list: if admin();
      allow create: if admin()
        || (signedIn() && request.resource.data.uid == request.auth.uid
            && !exists(/databases/$(database)/documents/meta/setup)
            && existsAfter(/databases/$(database)/documents/meta/setup));
      // An admin's username cannot be pointed at another login or removed by another admin
      // (that would lock them out), except while that admin account is being reset or handed over.
      allow update: if admin() && unOwnerFree(resource.data.get('uid', 'none'), name, false);
      allow delete: if admin() && unOwnerFree(resource.data.get('uid', 'none'), name, true);
    }

    match /settings/{doc} {
      allow read: if (active() && doc != 'security') || admin();
      allow write: if admin();
    }

    match /roomTypes/{id} {
      allow read: if active();
      allow write: if admin();
    }

    // Anyone on staff moves a room through cleaning, but only the front desk or a manager
    // can make it Ready (that is the inspection).
    match /rooms/{id} {
      allow read: if active();
      allow create, delete: if admin();
      allow update: if admin()
        || (active() && onlyChanges(['status', 'currentStayId', 'oooReason', 'readyAt'])
            && (request.resource.data.status != 'ready' || resource.data.status == 'ready' || desk()));
    }

    match /stays/{id} {
      allow read: if desk();
      allow create: if desk() && stampedByMe()
        && (admin() || (discountOk() && firstBillOk(request.resource.data)));
      allow update: if desk()
        && (admin()
            || ((discountOk() || request.resource.data.get('discountStatus', 'none') == resource.data.get('discountStatus', 'none'))
                && (('total' in resource.data)
                    ? billNotShrunk(resource.data, request.resource.data)
                    : firstBillOk(request.resource.data))));
      allow delete: if admin(); // the owner removing test records (Admin settings → Data)
    }

    // Staff record money in as "unconfirmed"; only the owner confirms it ("seen in bank"), marks it
    // not received, or voids it. A refund (money out) also waits for the owner as "unconfirmed".
    match /payments/{id} {
      allow read: if desk();
      allow create: if desk() && stampedByMe() && request.resource.data.amount is number
        && (admin()
            || (request.resource.data.amount > 0 && request.resource.data.status == 'unconfirmed')
            || (request.resource.data.amount < 0 && request.resource.data.status == 'unconfirmed')
            || (request.resource.data.kind == 'refund' && anyRole(['manager'])));
      allow update: if admin();
      allow delete: if admin(); // the owner removing test records (Admin settings → Data)
    }

    // A turnover clean is only "done" when the front desk or a manager passes the inspection.
    match /tasks/{id} {
      allow read, create: if active();
      allow update: if active()
        && (desk()
            || !(request.resource.data.status == 'done'
                 && request.resource.data.get('type', '') == 'turnover'
                 && resource.data.status != 'done'));
      allow delete: if admin();
    }

    match /jobs/{id} {
      allow read, create, update: if active();
      allow delete: if admin(); // the owner removing test records (Admin settings → Data)
    }

    match /assets/{id} {
      allow read: if active();
      allow create: if anyRole(['manager', 'maintenance']);
      allow update: if anyRole(['manager', 'maintenance']) || (active() && onlyChanges(['status']));
      allow delete: if false;
    }

    match /vendors/{id} {
      allow read: if active();
      allow write: if anyRole(['manager', 'maintenance']);
    }

    // Store items: only managers edit items; anyone may change the quantity (restocking, sales),
    // it must be a number, and every change of quantity is recorded in "moves".
    match /items/{id} {
      allow read: if active();
      allow create: if anyRole(['manager']);
      allow update: if anyRole(['manager'])
        || (active() && onlyChanges(['qty']) && request.resource.data.qty is number);
      allow delete: if false;
    }

    match /moves/{id} {
      allow read: if active();
      allow create: if active() && stampedByMe();
      allow update: if false;
      allow delete: if admin(); // test records only; the stock level is put back at the same time
    }

    // Expenses above the approval limit must be saved as "pending".
    match /expenses/{id} {
      allow read: if desk();
      allow create: if active() && stampedByMe() && request.resource.data.amount is number
        && (request.resource.data.status == 'pending'
            || admin()
            || (request.resource.data.status == 'approved' && request.resource.data.amount <= settings().approvalLimit));
      allow update: if admin();
      allow delete: if admin(); // the owner removing test records (Admin settings → Data)
    }

    match /incidents/{id} {
      allow read: if desk();
      allow create: if active() && stampedByMe();
      allow update: if anyRole(['manager']);
      allow delete: if admin(); // the owner removing test records (Admin settings → Data)
    }

    // Laundry batches: anyone on staff can send and count back; only the owner deletes (test records).
    match /laundry/{id} {
      allow read: if active();
      allow create: if active() && stampedByMe();
      allow update: if active();
      allow delete: if admin(); // the owner removing test records (Admin settings → Data)
    }

    // Front desk shifts: opened by yourself; closed by you, accepted by the next person.
    match /shifts/{id} {
      allow read: if desk();
      allow create: if desk() && request.resource.data.openedBy == request.auth.uid;
      allow update: if desk();
      allow delete: if admin(); // the owner removing test records (Admin settings → Data)
    }

    // Photos (guest IDs, slips, damage): opened one at a time by staff who hold the link to it
    // from a stay, payment or job. Nobody but the owner can read the whole collection.
    match /photos/{id} {
      allow get: if active();
      allow list: if admin();
      allow create: if active() && stampedByMe()
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow update: if false;
      allow delete: if admin();
    }

    // Activity log: anyone writes their own entries; nobody can edit or delete them.
    match /audit/{id} {
      allow read: if anyRole(['manager']);
      allow create: if active() && stampedByMe();
      allow update, delete: if false;
    }
  }
}
